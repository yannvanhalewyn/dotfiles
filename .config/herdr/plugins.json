[
  {
    "plugin_id": "annotate",
    "name": "Annotate",
    "version": "0.3.0",
    "min_herdr_version": "0.8.0",
    "description": "Comment on terminal selections and copy annotations as agent context.",
    "manifest_path": "/Users/yannvanhalewyn/dotfiles/.config/herdr/plugins/github/annotate-9c299759567c/herdr-plugin.toml",
    "plugin_root": "/Users/yannvanhalewyn/dotfiles/.config/herdr/plugins/github/annotate-9c299759567c",
    "enabled": true,
    "platforms": [
      "linux",
      "macos",
      "windows"
    ],
    "build": [
      {
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "bash",
          "scripts/fetch-plannotator-tui.sh"
        ]
      }
    ],
    "actions": [
      {
        "id": "capture",
        "title": "Annotate selection",
        "description": "Open a comment dialog for the current terminal selection.",
        "contexts": [
          "pane"
        ],
        "command": [
          "bun",
          "src/capture.ts"
        ]
      },
      {
        "id": "copy-context",
        "title": "Copy annotations as context",
        "description": "Copy all saved annotations to the clipboard as Markdown.",
        "contexts": [
          "global"
        ],
        "command": [
          "bun",
          "src/export.ts"
        ]
      },
      {
        "id": "last",
        "title": "Annotate: agent's last message",
        "description": "Review the focused agent's most recent message in plannotator-tui and send feedback back.",
        "contexts": [
          "pane"
        ],
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "./bin/plannotator-tui.exe",
          "herdr",
          "last"
        ]
      },
      {
        "id": "manage",
        "title": "Manage annotations",
        "description": "Browse, copy, archive, restore, and delete annotations.",
        "contexts": [
          "global"
        ],
        "command": [
          "bun",
          "src/open-manager.ts"
        ]
      },
      {
        "id": "open",
        "title": "Annotate: open here",
        "description": "Review the focused pane's folder in plannotator-tui and send feedback to its agent.",
        "contexts": [
          "workspace",
          "pane"
        ],
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "./bin/plannotator-tui.exe",
          "herdr",
          "open"
        ]
      },
      {
        "id": "open-link",
        "title": "Annotate this file",
        "description": "Open a Ctrl-clicked Markdown file in plannotator-tui.",
        "contexts": [
          "pane"
        ],
        "platforms": [
          "macos",
          "linux"
        ],
        "command": [
          "./bin/plannotator-tui.exe",
          "herdr",
          "open"
        ]
      }
    ],
    "panes": [
      {
        "id": "doc",
        "title": "Annotate",
        "platforms": [
          "macos",
          "linux"
        ],
        "placement": "overlay",
        "command": [
          "sh",
          "-c",
          "exec bash \"$HERDR_PLUGIN_ROOT/scripts/plannotator-tui.sh\" herdr pane"
        ]
      },
      {
        "id": "editor",
        "title": "Annotate",
        "placement": "popup",
        "width": 88,
        "height": 24,
        "command": [
          "bun",
          "src/editor.ts"
        ]
      },
      {
        "id": "manager",
        "title": "Annotations",
        "placement": "popup",
        "width": 100,
        "height": 30,
        "command": [
          "bun",
          "src/manager.ts"
        ]
      }
    ],
    "link_handlers": [
      {
        "id": "markdown-file",
